{
  "schema": "termux-os.package.v1",
  "id": "github.termux-os.service.termux-speech",
  "name": "Termux Speech",
  "version": "0.27.17",
  "description": "Speech control plane and transcript consumer: three-page WebUI (Overview run/controls, paged History, Settings) with speaker identity, audio playback and latency details. The legacy RMS/VAD/ASR product surface is retired; speech.idle, capability feeds and a live available-memory readout remain.",
  "types": [
    "service"
  ],
  "compatibility": {
    "framework": ">=0.3.0"
  },
  "entrypoints": {
    "backend": "package.mjs",
    "webui": "web/index.html"
  },
  "admin": {
    "title": "Termux Speech"
  },
  "verification": {
    "device": {
      "command": "node scripts/verify-device.mjs",
      "timeout_ms": 120000,
      "requires_running": true
    }
  },
  "components": {
    "services": [
      "termux-speech"
    ],
    "actions": [
      "speech.input.read",
      "speech.idle.request",
      "speech.listen.set"
    ],
    "apps": []
  },
  "capabilities": {
    "provides": [
      {
        "id": "speech.state",
        "provider": "termux-speech",
        "kind": "action",
        "action": "speech.state.read"
      },
      {
        "id": "speech.input",
        "provider": "termux-speech",
        "kind": "action",
        "action": "speech.input.read"
      },
      {
        "id": "speech.activity",
        "provider": "termux-speech",
        "kind": "feed",
        "service": "termux-speech",
        "endpoint": "/api/packages/github.termux-os.service.termux-speech/vad/activity"
      },
      {
        "id": "speech.transcript",
        "provider": "termux-speech",
        "kind": "feed",
        "service": "termux-speech",
        "endpoint": "/api/packages/github.termux-os.service.termux-speech/asr/transcripts"
      },
      {
        "id": "speech.idle",
        "provider": "termux-speech",
        "kind": "action",
        "action": "speech.idle.request"
      },
      {
        "id": "speech.listen",
        "provider": "termux-speech",
        "kind": "action",
        "action": "speech.listen.set"
      }
    ],
    "requires": [
      {
        "id": "termux-os.app.api",
        "required": true
      },
      {
        "id": "termux-os.assets.manager",
        "required": false
      }
    ]
  },
  "states": {
    "provides": [
      {
        "id": "speech.input",
        "type": "bool",
        "service": "termux-speech",
        "description": "Persistent Mic capture is live and PCM frames are fresh"
      },
      {
        "id": "speech.stage",
        "type": "enum",
        "values": [
          "rms",
          "vad",
          "asr"
        ],
        "service": "termux-speech",
        "description": "Current Pipeline lease owner"
      },
      {
        "id": "speech.voice",
        "type": "bool",
        "service": "termux-speech",
        "description": "FireRedVAD says someone is speaking right now"
      },
      {
        "id": "audio.input.route",
        "type": "enum",
        "values": [
          "built_in",
          "bluetooth",
          "wired",
          "usb",
          "unknown"
        ],
        "service": "termux-speech",
        "description": "Actual Android input route class"
      }
    ]
  },
  "menu": [
    {
      "parent": "/admin/services",
      "path": "/packages/github.termux-os.service.termux-speech/",
      "title": "Termux Speech",
      "order": 100
    }
  ],
  "ports": [
    {
      "id": "http",
      "protocol": "http",
      "visibility": "loopback",
      "health": "/health"
    }
  ],
  "runtime": {
    "framework": {
      "commands": [
        "node"
      ]
    },
    "termux_packages": [],
    "bundled": [],
    "external": []
  },
  "packages": {
    "requires": []
  },
  "release": {
    "repository": "https://github.com/johnson-yo/termux_os-service-termux_speech",
    "license": "Apache-2.0",
    "homepage": "https://github.com/johnson-yo/termux_os-service-termux_speech"
  },
  "assets": {
    "requires": [
      {
        "id": "model.sensevoice16.ctx",
        "required": false,
        "target": "current"
      }
    ]
  }
}
